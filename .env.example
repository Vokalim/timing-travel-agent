# SERVER ONLY. The browser never reads this file.
# Never put real values in dist/, HTML, browser storage, or public build variables.
# Create a test access token in Duffel Developer test mode.
DUFFEL_ACCESS_TOKEN=
# LLM trip parsing. Server only; never expose this in dist/ or browser code.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini, which supports strict Structured Outputs.
OPENAI_PREFERENCE_MODEL=gpt-4o-mini
# Optional. Defaults to OPENAI_PREFERENCE_MODEL for destination discovery.
OPENAI_DISCOVERY_MODEL=gpt-4o-mini
# Hotels remain Demo / not yet live. These placeholders are not used:
HOTEL_API_PROVIDER=
BOOKING_DEMAND_API_TOKEN=
BOOKING_AFFILIATE_ID=
